[Unit]
Description=Control-test AP gateway ACL
Wants=network-pre.target
Before=network-pre.target NetworkManager.service control-test-dnsmasq.service

[Service]
Type=oneshot
ExecStart=/bin/bash /etc/control-test/firewall.sh
ExecReload=/bin/bash /etc/control-test/firewall.sh
RemainAfterExit=yes
# Deliberately no ExecStop: stopping a unit must not open student Internet access.

[Install]
WantedBy=multi-user.target
