[Unit]
Description=Control Test FastAPI Service
After=network.target

[Service]
Type=simple
User=aaf
Group=aaf
WorkingDirectory=/home/aaf/git/control-test
Environment="PYTHONUNBUFFERED=1"
ExecStart=/home/aaf/git/control-test/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
